# ─── Apex Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# In production, use a secrets manager (AWS Secrets Manager, Vault, etc.)
# and inject as environment variables, not files.

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_VERSION=0.1.0
PORT=8080
LOG_LEVEL=info               # debug | info | warn | error

# ─── Database ────────────────────────────────────────────────────────────────
# Format: postgres://user:password@host:port/dbname?sslmode=require
# In production, always use sslmode=require
DATABASE_URL=postgres://apex:changeme@localhost:5432/apex_dev?sslmode=disable

# Connection pool tuning (defaults are usually fine)
DB_MAX_CONNS=25
DB_CONN_IDLE_TIME=5m

# ─── Redis ───────────────────────────────────────────────────────────────────
# Format: redis://[:password@]host:port/db_number
REDIS_URL=redis://localhost:6379/0

# ─── Authentication ──────────────────────────────────────────────────────────
# REQUIRED: Must be at least 32 characters in production.
# Generate with: openssl rand -base64 64
JWT_SECRET=

# Token expiry (Go duration format: 24h, 1h30m, etc.)
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h    # 7 days

# ─── Ingestion Limits ────────────────────────────────────────────────────────
MAX_EVENTS_PER_BATCH=1000
MAX_PAYLOAD_BYTES=5242880    # 5MB

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# These are per-project limits; configure per-tier in production
INGEST_RATE_LIMIT=10000      # requests per minute
API_RATE_LIMIT=100           # requests per minute per user

# ─── Alerting Integrations ───────────────────────────────────────────────────
# Slack webhook for internal alert notifications (optional)
SLACK_WEBHOOK_URL=

# SendGrid for email alerts (optional)
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=alerts@apex.dev

# ─── Observability ───────────────────────────────────────────────────────────
# OpenTelemetry collector endpoint (optional; for traces)
OTEL_ENDPOINT=

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# ─── Feature Flags ───────────────────────────────────────────────────────────
ENABLE_REGISTRATION=true     # set to false to invite-only
ENABLE_DEMO_PROJECT=true     # auto-create demo data for new users
